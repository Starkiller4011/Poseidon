<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.7" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" PrivateAssets="all" />
    <ProjectReference Include="..\..\..\System\Core\CoreUI\CoreUI.csproj" />
    <ProjectReference Include="..\..\..\System\Core\Core\Core.csproj" />
    <ProjectReference Include="..\..\..\System\Core\CoreDisplay\CoreDisplay.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\System\Core\CoreTracks\CoreTracks.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\System\Core\CoreAIS\CoreAIS.csproj" ReferenceOutputAssembly="false" />
    <None Include="..\..\..\System\Core\CoreDisplay\module.json" Link="packages\CoreDisplay\module.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\System\Core\CoreTracks\module.json" Link="packages\CoreTracks\module.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\System\Core\CoreAIS\module.json" Link="packages\CoreAIS\module.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Real CoreUI/Display/Tracks/AIS packages for runtime integration tests; none but CoreUI is a compile-time reference. -->
  <Target Name="CopyDisplayPackage" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\..\System\Core\CoreDisplay\bin\$(Configuration)\net10.0\CoreDisplay.dll"
          DestinationFolder="$(TargetDir)packages\CoreDisplay" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\..\System\Core\CoreTracks\bin\$(Configuration)\net10.0\CoreTracks.dll"
          DestinationFolder="$(TargetDir)packages\CoreTracks" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\..\System\Core\CoreAIS\bin\$(Configuration)\net10.0\CoreAIS.dll"
          DestinationFolder="$(TargetDir)packages\CoreAIS" />
  </Target>
</Project>
