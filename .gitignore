# Reference/Data: downloaded reference material (IHO documents, schema archives, specifications)
# stays local. Only the plan files, the Data project, the Specifications provenance note and the
# submodules are committed; a new submodule needs its own line here.
/Reference/Data/*
!/Reference/Data/Plan-Memory/
!/Reference/Data/Data.csproj
!/Reference/Data/Program.cs
!/Reference/Data/Specifications/
/Reference/Data/Specifications/*
!/Reference/Data/Specifications/README.md
!/Reference/Data/ENCWG
!/Reference/Data/NIWCSoftwareTestbed
!/Reference/Data/S-100-Standard-Development
!/Reference/Data/S-100-Validation-Checks
!/Reference/Data/S-100-xmlbindings
!/Reference/Data/S-100UML
!/Reference/Data/S-100WG
!/Reference/Data/S-101-Test-Datasets
!/Reference/Data/S-101-Validation
